
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'GitHub repository checked out by Jenkins'
            }
        }

        stage('Locate Project') {
            steps {
                dir('healthcare-appointment/healthcare-appointment') {
                    bat 'dir'
                }
            }
        }

        stage('Build and Test') {
            steps {
                dir('healthcare-appointment/healthcare-appointment') {
                    bat 'mvnw.cmd -B clean test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('healthcare-appointment/healthcare-appointment') {
                    bat 'mvnw.cmd -B package -DskipTests'
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true,
                  testResults: '**/target/surefire-reports/*.xml'
        }
    }
}
